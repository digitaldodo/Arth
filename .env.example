# ==============================================================================
# Arth Modular Monorepo Environment Template
# ==============================================================================
# Non-secret placeholders documented in ANTIGRAVITY.md & ARTH_ARCHITECTURE.md.
# Copy this file to .env.local (or package-specific .env) for development.
# NEVER commit .env.local or production secrets to source control.
# ==============================================================================

# Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend API Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase (PostgreSQL database, Auth, RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server only: backend admin/worker tasks only

# Google Sheets Integration (Phase 02 - Authoritative Outbox Pattern Sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=    # server only: backend worker only
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=  # server only: backend worker only
GOOGLE_SHEETS_SPREADSHEET_ID=    # server only: backend worker only
