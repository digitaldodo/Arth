# ==============================================================================
# Arth Environment Variables Template
# ==============================================================================
# Non-secret placeholder names documented in ANTIGRAVITY.md & ARTH_ARCHITECTURE.md.
# Copy this file to .env.local and populate with your own development credentials.
# NEVER commit .env.local or real credentials to source control.
# ==============================================================================

# Supabase (Auth, PostgreSQL database, RLS policies)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server only: for admin scripts, background tasks

# Google Sheets (Phase 02 integration - Outbox pattern sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=    # server only: service account email
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=  # server only: private key string
GOOGLE_SHEETS_SPREADSHEET_ID=    # server only: target sheet document ID

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
