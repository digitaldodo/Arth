# ==============================================================================
# Arth Modular Monorepo Environment Template
# ==============================================================================
# Non-secret placeholders documented in ANTIGRAVITY.md & docs/ARTH_ARCHITECTURE.md.
# Copy this file to .env.local (or configure in Vercel / Render dashboard).
# NEVER commit .env.local or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Service (@arth/frontend — Deployed to Vercel)
# ------------------------------------------------------------------------------
# Public application URL for OAuth redirects and canonical links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authoritative Supabase project URL (used by @supabase/ssr server client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Authoritative Supabase anon / public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# CRITICAL IN PRODUCTION: Deployed Fastify backend API HTTPS base URL.
# Used exclusively server-side by Next.js BFF Route Handlers (/api/backend/*).
# Must be set in Vercel project environment variables (e.g. https://arth-api.onrender.com).
# In local development, defaults to http://localhost:3001 if omitted.
INTERNAL_API_URL=http://localhost:3001

# Optional fallback for public direct API access (rarely needed)
NEXT_PUBLIC_API_URL=http://localhost:3001

# (Required for username login): Server-only Supabase service-role secret.
# Used exclusively server-side by Next.js Server Actions to securely resolve usernames to emails.
# Must be set in Vercel project environment variables.
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose to client browser bundles.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. Backend API Service (@arth/backend — Deployed to Render / Managed Node.js)
# ------------------------------------------------------------------------------
# Network listener port (Render / cloud hosts set this automatically)
PORT=3001

# Network bind interface (0.0.0.0 is required for container / managed ingress)
HOST=0.0.0.0

# Runtime environment (production / development / test)
NODE_ENV=development

# Allowed CORS origin(s) matching the deployed frontend domain (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000

# Authoritative Supabase project URL for database RPC & JWKS verification
SUPABASE_URL=https://your-project-ref.supabase.co

# Authoritative Supabase anon key for user-scoped PostgREST client creation
SUPABASE_ANON_KEY=eyJhbGciOi...

# (Recommended) Supabase JWT secret for high-performance local HS256 verification.
# Found in: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret (NOT the anon key).
# If omitted or when using asymmetric signing, Fastify authoritatively verifies tokens via Supabase Auth / JWKS.
SUPABASE_JWT_SECRET=

# (Optional) Expected JWT audience claim (defaults to "authenticated")
JWT_AUDIENCE=authenticated

# ------------------------------------------------------------------------------
# 3. Phase 02: Google Sheets Synchronization & Outbox Worker (Vercel / Server-Only)
# ------------------------------------------------------------------------------
# Server-only Supabase service-role key. Used by the outbox worker to atomically
# claim and update outbox_events and manage user_sheet_connections across users.
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret.
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose to client browser bundles.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Google Cloud Service Account email with Google Sheets API enabled.
# Displayed to users so they can share their spreadsheet with Editor permissions.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=arth-sheets-sync@your-gcp-project.iam.gserviceaccount.com

# Google Cloud Service Account RSA Private Key (PEM format).
# Supports multiline PEM or escaped single-line PEM with \n.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...=\n-----END PRIVATE KEY-----\n"

# Shared secret used to authenticate scheduled Vercel Cron requests to /api/sync/sheets
# and /api/sync/reconcile. Vercel automatically sends `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=your_random_secure_cron_secret_string
