# SpendSense Admin Portal — Environment Template (Local & Future Deployment)
# Never store raw passwords, roll numbers, or service role secrets in committed files.

# Server-side BFF target to the shared Fastify backend
ADMIN_BACKEND_URL=http://127.0.0.1:3001
NEXT_PUBLIC_ADMIN_PORTAL_NAME=SpendSense Admin

# Set only in production HTTPS deployments
NODE_ENV=development
