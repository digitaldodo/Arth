<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LauncherActivity" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F8F8F6</item>
        <item name="android:navigationBarColor">#F8F8F6</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.ArthCompanion" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#181615</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F8F8F6</item>
        <item name="android:navigationBarColor">#F8F8F6</item>
    </style>
    <style name="Theme.Arth" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F8F8F6</item>
        <item name="android:navigationBarColor">#F8F8F6</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Arth.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F8F6</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Arth</item>
    </style>
</resources>
